[Unit]
Description=MentorPi remote operation (ROS 2 base + foxglove_bridge + supervisor)
# network-online (not just network): DDS participants bind whatever
# interfaces exist at process start. If the stack starts before wlan0
# associates, boot-time nodes bind lo-only while later-spawned nodes
# (supervisor mode switches) bind lo+wlan — discovery splits and topics
# silently stop flowing between them (observed 2026-07-05).
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
# Explicit list so systemd-late versions don't drop supplementary groups.
SupplementaryGroups=dialout video plugdev input

WorkingDirectory=/home/pi/workdir/mentorpi/mentorpi_ws
Environment=HOME=/home/pi
# Minimal PATH that excludes conda's bin so any nested `python3` resolves to
# the system 3.12 (jazzy's rclpy C extension is built for 3.12).
Environment=PATH=/usr/bin:/usr/local/bin:/opt/ros/jazzy/bin

# NOTE: do NOT set ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST here. Tried
# 2026-07-05 to shield DDS from WiFi dropouts; on Jazzy/FastDDS it broke
# image topics, action results and wedged the supervisor at boot.
# WiFi-dropout resilience needs a proper FastDDS interface-whitelist
# profile instead (TODO).

# WiFi power save causes several dropouts per day on this board; turn it
# off before the stack starts. "+" = run as root, "-" = non-fatal if iw
# is missing.
ExecStartPre=-+/usr/sbin/iw dev wlan0 set power_save off

# Bounded wait for NTP sync. The Pi has no RTC battery: fake-hwclock boots
# on the time saved at last shutdown, and if ROS starts before NTP fixes
# it, the later clock step (observed +22h, 2026-07-17) silently breaks
# EKF/TF/DDS across the whole stack. 60 s cap keeps fully-offline boots
# possible; a step that arrives later is caught by mentorpi-clockguard,
# which restarts this unit.
ExecStartPre=-/bin/bash -c 'for i in $(seq 60); do [ "$(timedatectl show -p NTPSynchronized --value)" = "yes" ] && exit 0; sleep 1; done; echo "NTP not synced after 60s; starting on current clock (clockguard will catch a late step)"'
TimeoutStartSec=180

# Use non-login non-interactive bash to avoid sourcing ~/.bashrc (which on this
# box auto-activates miniforge and breaks rclpy imports).
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source install/setup.bash && exec ros2 launch mentorpi_supervisor remote.launch.py'

# ros2 launch propagates SIGINT to its children for graceful shutdown.
KillSignal=SIGINT
TimeoutStopSec=30

Restart=on-failure
RestartSec=5

# A burst of resets within a short window means something fundamental is broken
# (e.g. /dev/ttyACM0 not enumerated yet, USB camera unplugged); back off instead
# of hammering systemd.
StartLimitBurst=5
StartLimitIntervalSec=60

[Install]
WantedBy=multi-user.target
