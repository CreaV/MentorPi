{
  "configById": {
    "3D!loccheck": {
      "cameraState": {
        "perspective": false,
        "distance": 10,
        "phi": 0.1,
        "thetaOffset": 0,
        "targetOffset": [0, 0, 0],
        "target": [0, 0, 0],
        "fovy": 45,
        "near": 0.5,
        "far": 5000
      },
      "followMode": "follow-none",
      "followTf": "map",
      "scene": {
        "labelScaleFactor": 0.3,
        "transforms": {
          "axisScale": 0.4,
          "showLabel": false,
          "labelSize": 0.05
        }
      },
      "transforms": {
        "frame:map": {"visible": true},
        "frame:odom": {"visible": true},
        "frame:base_link": {"visible": true}
      },
      "topics": {
        "/map": {"visible": true, "colorMode": "custom", "minColor": "#e8e8e8ff", "maxColor": "#1a1a66ff", "unknownColor": "#00000000", "frameLocked": true},
        "/rtabmap/cloud": {"visible": true, "pointSize": 2, "colorMode": "rgb"},
        "/scan": {"visible": true, "colorMode": "flat", "flatColor": "#ff2200", "pointSize": 8, "decayTime": 0},
        "/localization_pose": {"visible": true, "type": "arrow", "color": "#33ddff", "showCovariance": true, "covarianceColor": "#33ddff33"},
        "/odometry/filtered": {"visible": false}
      },
      "layers": {}
    },
    "Image!cam": {
      "cameraState": {},
      "topic": "/viewer/color_compressed",
      "transformMarkers": false,
      "synchronize": false,
      "smooth": false,
      "flipHorizontal": false,
      "flipVertical": false,
      "rotation": 0
    },
    "Image!depth": {
      "cameraState": {},
      "topic": "/viewer/depth_raw",
      "transformMarkers": false,
      "synchronize": false,
      "smooth": false,
      "flipHorizontal": false,
      "flipVertical": false,
      "rotation": 0,
      "minValue": 300,
      "maxValue": 4000
    },
    "Indicator!mode": {
      "path": "/mode/status.data",
      "style": "background",
      "rules": [
        {"operator": "=", "rawValue": "idle", "color": "#888888", "label": "IDLE"},
        {"operator": "=", "rawValue": "slam_3d", "color": "#33aa44", "label": "3D SLAM"},
        {"operator": "=", "rawValue": "loc_3d", "color": "#33ddff", "label": "3D LOC"},
        {"operator": "=", "rawValue": "loc_2d", "color": "#aa44aa", "label": "2D LOC"},
        {"operator": "=", "rawValue": "slam_2d", "color": "#3388ff", "label": "2D SLAM"}
      ],
      "fallbackColor": "#444444",
      "fallbackLabel": "?"
    },
    "Gauge!battery": {
      "path": "/battery.voltage",
      "minValue": 6.4,
      "maxValue": 8.4,
      "colorMap": "red-yellow-green",
      "colorMode": "colormap",
      "gradient": ["#ff3333", "#33aa44"],
      "reverse": false
    },
    "Indicator!guard": {
      "path": "/guard/blocked.data",
      "style": "background",
      "rules": [
        {"operator": "=", "rawValue": "", "color": "#2c7a3f", "label": "GUARD CLEAR"}
      ],
      "fallbackColor": "#cc3300",
      "fallbackLabel": "BLOCKED"
    },
    "Teleop!drive": {
      "topic": "/cmd_vel",
      "publishRate": 10,
      "upButton": {"field": "linear-x", "value": 0.25},
      "downButton": {"field": "linear-x", "value": -0.25},
      "leftButton": {"field": "angular-z", "value": 1.0},
      "rightButton": {"field": "angular-z", "value": -1.0}
    },
    "CallService!setIdle": {
      "serviceName": "/mode/set",
      "requestPayload": "{\n  \"mode\": \"idle\",\n  \"map_file\": \"\",\n  \"database_path\": \"\"\n}",
      "layout": "vertical",
      "advancedView": false,
      "buttonText": "Stop (idle)",
      "buttonTooltip": "Stop active mode and go idle",
      "buttonColor": "#888888"
    },
    "CallService!setLoc3d": {
      "serviceName": "/mode/set",
      "requestPayload": "{\n  \"mode\": \"loc_3d\",\n  \"map_file\": \"\",\n  \"database_path\": \"\"\n}",
      "layout": "vertical",
      "advancedView": true,
      "buttonText": "Start 3D Localization",
      "buttonTooltip": "rtabmap loc mode. Set database_path in advanced view to pick a .db (default ~/rtabmap_maps/rtabmap.db).",
      "buttonColor": "#33ddff"
    },
    "CallService!setSlam3d": {
      "serviceName": "/mode/set",
      "requestPayload": "{\n  \"mode\": \"slam_3d\",\n  \"map_file\": \"\",\n  \"database_path\": \"\",\n  \"load_all_nodes\": false\n}",
      "layout": "vertical",
      "advancedView": true,
      "buttonText": "3D SLAM: NEW map",
      "buttonTooltip": "New RTAB-Map mapping session. Set database_path to a NEW filename to avoid appending to an old db.",
      "buttonColor": "#33aa44"
    },
    "CallService!setSlam3dExtend": {
      "serviceName": "/mode/set",
      "requestPayload": "{\n  \"mode\": \"slam_3d\",\n  \"map_file\": \"\",\n  \"database_path\": \"\",\n  \"load_all_nodes\": true\n}",
      "layout": "vertical",
      "advancedView": true,
      "buttonText": "3D SLAM: EXTEND map",
      "buttonTooltip": "Continue/extend an existing db (load_all_nodes=true relocalizes & merges at start). Set database_path to the db you want to grow.",
      "buttonColor": "#559933"
    },
    "CallService!listMaps": {
      "serviceName": "/mode/list_maps",
      "requestPayload": "{\n  \"mode\": \"slam_3d\"\n}",
      "layout": "vertical",
      "advancedView": false,
      "buttonText": "List 3D maps",
      "buttonTooltip": "List ~/rtabmap_maps/*.db (mode=slam_3d) or ~/maps/*.posegraph (mode=loc_2d)."
    },
    "CallService!guardOn": {
      "serviceName": "/mentorpi_base/set_parameters",
      "requestPayload": "{\n  \"parameters\": [\n    {\n      \"name\": \"obstacle_guard\",\n      \"value\": { \"type\": 1, \"bool_value\": true }\n    }\n  ]\n}",
      "layout": "vertical",
      "advancedView": false,
      "buttonText": "Guard ON",
      "buttonTooltip": "Enable lidar/depth obstacle guard on base_node.",
      "buttonColor": "#2c7a3f"
    },
    "CallService!guardOff": {
      "serviceName": "/mentorpi_base/set_parameters",
      "requestPayload": "{\n  \"parameters\": [\n    {\n      \"name\": \"obstacle_guard\",\n      \"value\": { \"type\": 1, \"bool_value\": false }\n    }\n  ]\n}",
      "layout": "vertical",
      "advancedView": false,
      "buttonText": "Guard OFF",
      "buttonTooltip": "Disable obstacle guard (danger: no auto-stop). base_node param.",
      "buttonColor": "#cc3300"
    },
    "CallService!guardDist": {
      "serviceName": "/mentorpi_base/set_parameters",
      "requestPayload": "{\n  \"parameters\": [\n    {\n      \"name\": \"guard_stop_distance\",\n      \"value\": { \"type\": 3, \"double_value\": 0.30 }\n    },\n    {\n      \"name\": \"guard_slow_distance\",\n      \"value\": { \"type\": 3, \"double_value\": 0.60 }\n    }\n  ]\n}",
      "layout": "vertical",
      "advancedView": true,
      "buttonText": "Set guard distances",
      "buttonTooltip": "Edit double_value in advanced view. stop=清零分量距离 (from lidar center), slow=开始减速距离. Both m.",
      "buttonColor": "#556677"
    },
    "Parameters!guard": {
      "title": "base_node params (guard/*)"
    },
    "RawMessages!pose": {
      "topicPath": "/localization_pose.pose.pose.position"
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {"speed": 1.0},
  "layout": {
    "first": "3D!loccheck",
    "second": {
      "first": {
        "first": "Image!cam",
        "second": "Image!depth",
        "direction": "row",
        "splitPercentage": 50
      },
      "second": {
        "first": {
          "first": "Indicator!mode",
          "second": {
            "first": "Gauge!battery",
            "second": "Indicator!guard",
            "direction": "row",
            "splitPercentage": 50
          },
          "direction": "row",
          "splitPercentage": 34
        },
        "second": {
          "first": "Teleop!drive",
          "second": {
            "first": {
              "first": {
                "first": "CallService!setIdle",
                "second": "CallService!setLoc3d",
                "direction": "row",
                "splitPercentage": 45
              },
              "second": {
                "first": {
                  "first": "CallService!setSlam3d",
                  "second": "CallService!setSlam3dExtend",
                  "direction": "row"
                },
                "second": "CallService!listMaps",
                "direction": "row",
                "splitPercentage": 70
              },
              "direction": "column"
            },
            "second": {
              "first": {
                "first": {
                  "first": "CallService!guardOn",
                  "second": "CallService!guardOff",
                  "direction": "row"
                },
                "second": "CallService!guardDist",
                "direction": "row",
                "splitPercentage": 66
              },
              "second": "Parameters!guard",
              "direction": "column",
              "splitPercentage": 35
            },
            "direction": "column",
            "splitPercentage": 52
          },
          "direction": "column",
          "splitPercentage": 26
        },
        "direction": "column",
        "splitPercentage": 20
      },
      "direction": "column",
      "splitPercentage": 32
    },
    "direction": "row",
    "splitPercentage": 58
  }
}
