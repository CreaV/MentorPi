<?xml version="1.0" ?>
<!--
  MentorPi mecanum geometry source of truth.
  runtime_mode=false: complete offline/RViz model rooted at base_footprint.
  runtime_mode=true: hardware TF model rooted at base_link; EKF owns
  odom->base_link and the Orbbec driver owns camera-internal frames.
  Wheel geometry is still an estimate and must stay synchronized with
  mentorpi_base/base_node.py after drivetrain calibration.
-->
<robot name="mentorpi_mecanum" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="runtime_mode" default="false"/>
  <!-- with_so101: SO-101 机械臂车载布局。include 放在 if 块内(xacro 惰性求值),
       未启用时不依赖 so101.xacro 存在。 -->
  <xacro:arg name="with_so101" default="false"/>

  <!-- ===== 几何参数（与 base_node.py 同步） ===== -->
  <!-- 有效轴距 (Step 1.2 对墙旋转标定 2026-07-16, k_geom=1.117, 与
       base_node.py _mecanum 同步; 物理尺量 0.1368/0.1410, 差值为麦轮
       原地旋转打滑 → 轮子视觉位置比实物略外扩 ~8mm, 属已知取舍) -->
  <xacro:property name="wheelbase"     value="0.1528"/>
  <xacro:property name="track_width"   value="0.1575"/>
  <xacro:property name="wheel_diameter" value="0.0636"/>  <!-- Step 1.1 calibrated 2026-07-05, synced with base_node.py -->

  <xacro:property name="wheel_radius"  value="${wheel_diameter/2}"/>
  <xacro:property name="x_off"         value="${wheelbase/2}"/>     <!-- 0.0684 -->
  <xacro:property name="y_off"         value="${track_width/2}"/>   <!-- 0.0705 -->
  <xacro:property name="wheel_z"       value="-0.018408"/>          <!-- 轮心相对 base_link 的 z（CAD 值） -->
  <xacro:property name="base_z"        value="0.0505"/>             <!-- base_footprint → base_link，由 wheel_z + wheel_radius 推 -->

  <xacro:property name="PI" value="3.1415926535897931"/>

  <material name="black"><color rgba="0 0 0 1"/></material>
  <material name="white"><color rgba="1 1 1 1"/></material>

  <!-- ===== Root: base_footprint (REP-105) ===== -->
  <xacro:unless value="$(arg runtime_mode)">
    <link name="base_footprint"/>
    <joint name="base_footprint_to_base_link" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
    </joint>
  </xacro:unless>

  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="7.82634169708696E-05 3.66518389137982E-05 0.0068167426737893"/>
      <mass value="0.080358044299185"/>
      <inertia ixx="9.92047502462735E-05" ixy="3.20099144678921E-08" ixz="1.15869166655817E-05"
               iyy="0.000292461515602123" iyz="-2.92890751882614E-08" izz="0.000367604260834833"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://mentorpi_description/meshes/mecanum/base_link.STL"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://mentorpi_description/meshes/mecanum/base_link.STL"/></geometry>
    </collision>
  </link>

  <!-- ===== Wheels: 4× continuous joint ===== -->
  <xacro:macro name="mecanum_wheel" params="prefix x y mesh">
    <link name="wheel_${prefix}_Link">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <mass value="0.0378743634664218"/>
        <inertia ixx="3.67678518315829E-06" ixy="0" ixz="0"
                 iyy="5.81008995754212E-06" iyz="0" izz="3.67939460898329E-06"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry><mesh filename="package://mentorpi_description/meshes/mecanum/${mesh}"/></geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry><mesh filename="package://mentorpi_description/meshes/mecanum/${mesh}"/></geometry>
      </collision>
    </link>
    <joint name="wheel_${prefix}_Joint" type="continuous">
      <origin rpy="0 0 0" xyz="${x} ${y} ${wheel_z}"/>
      <parent link="base_link"/>
      <child link="wheel_${prefix}_Link"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:mecanum_wheel prefix="lf" x=" ${x_off}" y=" ${y_off}" mesh="wheel_lf_Link.STL"/>
  <xacro:mecanum_wheel prefix="rf" x=" ${x_off}" y="-${y_off}" mesh="wheel_rf_Link.STL"/>
  <xacro:mecanum_wheel prefix="lb" x="-${x_off}" y=" ${y_off}" mesh="wheel_lb_Link.STL"/>
  <xacro:mecanum_wheel prefix="rb" x="-${x_off}" y="-${y_off}" mesh="wheel_rb_Link.STL"/>

  <!-- ===== IMU (runtime estimate; Part 2 calibration pending) ===== -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- STM32 board center ruler-measured 5.4cm behind base center, laterally
         symmetric; z est. Translation is cosmetic: EKF fuses only gyro vyaw
         and Madgwick only the gravity vector, both position-independent. Only
         RPY axis alignment matters; static read (az≈+9.8, ax/ay small)
         confirms z-up, no axis flip. Refine RPY in Part 2 if board is skewed. -->
    <origin xyz="-0.054 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- ===== Camera (Gemini 2, AprilTag hand-eye calibrated) ===== -->
  <link name="camera_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0023 0.0011 -0.0102"/>
      <mass value="0.027"/>
      <inertia ixx="1.44E-05" ixy="0" ixz="0" iyy="1.66E-06" iyz="0" izz="1.46E-05"/>
    </inertial>
    <!-- 视觉修正(纯外观,与标定分离): camera_link 现是 AprilTag 标定的光学中心,
         而 cam_Link.STL 以机身顶面中心为原点建模。此偏移把网格本体拉回 CAD 本体位
         (= CAD 本体 0.061376/0/0.051154 减光学中心, 转到 camera_link 帧); 不加则
         机身网格前移 ~4cm 看似装歪。改标定时按新光学中心重算, 勿手改凑render。 -->
    <visual>
      <origin rpy="0 0 0" xyz="-0.0407 -0.0124 0.0023"/>
      <geometry><mesh filename="package://mentorpi_description/meshes/mecanum/cam_Link.STL"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.0407 -0.0124 0.0023"/>
      <geometry><mesh filename="package://mentorpi_description/meshes/mecanum/cam_Link.STL"/></geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- AprilTag hand-eye calibration, 2026-07-24 (直装无支撑相机, 光学中心;
         position-only RMS 9.6mm, 7 poses; z=0.0535 尺量固定, 平面运动不可观)。
         重标: scripts/calibrate_camera_extrinsic.py 的 update-xacro 选项。 -->
    <origin xyz="0.1017 0.0137 0.0535" rpy="-0.0171 -0.1196 0.0323"/>
  </joint>

  <!-- Offline preview only; Orbbec owns these frames on hardware. -->
  <xacro:unless value="$(arg runtime_mode)">
    <link name="camera_color_optical_frame"/>
    <joint name="camera_color_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_color_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
    </joint>

    <link name="camera_depth_optical_frame"/>
    <joint name="camera_depth_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_depth_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
    </joint>
  </xacro:unless>

  <!-- ===== Lidar (MS200) ===== -->
  <link name="laser_frame">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.018"/>
      <mass value="0.04"/>
      <inertia ixx="4.98E-06" ixy="0" ixz="0" iyy="5.04E-06" iyz="0" izz="8.26E-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://mentorpi_description/meshes/mecanum/lidar_Link.STL"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><mesh filename="package://mentorpi_description/meshes/mecanum/lidar_Link.STL"/></geometry>
    </collision>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <!-- Recovered vendor-CAD transform from mecanum.pre_calibration.xacro.
         base_link is 50.5 mm above ground; lidar_Link.STL spans z=-35..0 mm.
         This places both the chassis top and lidar bottom at 108.001 mm and
         laser_frame at 143.001 mm above ground: direct mount, no tower. -->
    <origin xyz="-0.012242 0 0.092501" rpy="0 0 0"/>
  </joint>


  <!-- ===== SO-101 机械臂(可选, with_so101:=true) =====
       布局 v3(2026-07-19, STL/实物测量闭环):
       - 臂朝前(yaw 0): Gemini 2 天然成为 VLA context 相机,前伸时夹爪入画
       - 雷达直接贴装于顶板,laser_frame z=0.092501;臂收拢姿态占据的后向扇区
         用激光角度掩膜滤除;抓取作业时停车(motion primitive 安全模型)
       - 臂基座后移至 x=-0.155: 真网格 pan 全程(±110°)扫掠最差裕量
         头部 36.2mm(恢复 TF 后实算);甲板用雷达后方 4 个 M4 通孔向后悬伸
         ~92mm,前缘 x=-0.050,与雷达网格保留约 11mm 平面间隙 -->
  <xacro:if value="$(arg with_so101)">
    <xacro:include filename="$(find mentorpi_description)/urdf/so101.xacro"/>
    <xacro:so101_module
      parent="base_link"
      mount_xyz="-0.155 0 0.0655"
      mount_rpy="0 0 0"/>

    <!-- 悬伸甲板 (mechanical/printable/so101_deck_plate.py):
         x -0.195..-0.050, y ±0.048, 顶面 z=0.0655, 底面纵肋 15 深 -->
    <link name="so101_deck_link">
      <inertial>
        <origin xyz="-0.1225 0 -0.004" rpy="0 0 0"/>
        <mass value="0.16"/>
        <inertia ixx="0.000124" ixy="0" ixz="0"
                 iyy="0.000281" iyz="0" izz="0.000403"/>
      </inertial>
      <visual>
        <origin xyz="-0.1225 0 -0.008" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://mentorpi_description/meshes/accessories/so101_deck_plate.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="deck_orange"><color rgba="0.95 0.35 0.08 1"/></material>
      </visual>
      <collision>
        <origin xyz="-0.1225 0 -0.004" rpy="0 0 0"/>
        <geometry><box size="0.145 0.096 0.008"/></geometry>
      </collision>
    </link>
    <joint name="so101_deck_joint" type="fixed">
      <parent link="base_link"/>
      <child link="so101_deck_link"/>
      <origin xyz="0 0 0.0655" rpy="0 0 0"/>
    </joint>

    <!-- 臂供电 2S 锂电: 前挂托架 (mechanical/printable/battery_tray_2s.py),
         兼作前配重抗后倾。包络暂按 2S2200 (105x33x24) —— 购得实物后改
         PACK_* 重出。挂线(网格切片实测,P0 卡尺复核): 底盘鼻部无垂直
         前脸——托架背面贴中层甲板前缘 x=0.080, 挂唇压其顶面 z=0.0253。 -->
    <link name="battery_tray_link">
      <inertial>
        <origin xyz="0 0 0.010" rpy="0 0 0"/>
        <mass value="0.06"/>
        <inertia ixx="0.00008" ixy="0" ixz="0"
                 iyy="0.00002" iyz="0" izz="0.00009"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://mentorpi_description/meshes/accessories/battery_tray_2s.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="tray_blue"><color rgba="0.10 0.35 0.80 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.0155" rpy="0 0 0"/>
        <geometry><box size="0.0406 0.1126 0.031"/></geometry>
      </collision>
    </link>
    <joint name="battery_tray_joint" type="fixed">
      <parent link="base_link"/>
      <child link="battery_tray_link"/>
      <!-- 背面 x = 0.080 - outer_x/2 + outer_x = 0.0203+0.080; 挂唇底
           z = -0.0017 + 0.027 = 0.0253 (中层甲板顶面)。 -->
      <origin xyz="0.1003 0 -0.0017" rpy="0 0 0"/>
    </joint>
    <link name="battery_2s_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.18"/>
        <inertia ixx="0.000174" ixy="0" ixz="0"
                 iyy="0.0000250" iyz="0" izz="0.000182"/>
      </inertial>
      <visual>
        <geometry><box size="0.033 0.105 0.024"/></geometry>
        <material name="lipo_gray"><color rgba="0.25 0.26 0.30 1"/></material>
      </visual>
      <collision><geometry><box size="0.033 0.105 0.024"/></geometry></collision>
    </link>
    <joint name="battery_2s_joint" type="fixed">
      <parent link="battery_tray_link"/>
      <child link="battery_2s_link"/>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
    </joint>
  </xacro:if>

</robot>
