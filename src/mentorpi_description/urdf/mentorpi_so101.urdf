         x -0.195..-0.050, y ±0.048, 顶面 z=0.0655, 底面纵肋 15 深 -->
  <link name="so101_deck_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.1225 0 -0.004"/>
      <mass value="0.16"/>
      <inertia ixx="0.000124" ixy="0" ixz="0" iyy="0.000281" iyz="0" izz="0.000403"/>
