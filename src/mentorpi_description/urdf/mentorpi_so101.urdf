    <origin rpy="0 0 0" xyz="0 0 0.0655"/>
  </joint>
  <!-- 臂供电 2S 锂电: 前挂托架 (mechanical/printable/battery_tray_2s.py),
         兼作前配重抗后倾。包络暂按 2S2200 (105x33x24) —— 购得实物后改
         PACK_* 重出。挂线(网格切片实测,P0 卡尺复核): 底盘鼻部无垂直
         前脸——托架背面贴中层甲板前缘 x=0.080, 挂唇压其顶面 z=0.0253。 -->
  <link name="battery_tray_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.010"/>
      <mass value="0.06"/>
      <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00009"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://mentorpi_description/meshes/accessories/battery_tray_2s.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="tray_blue">
        <color rgba="0.10 0.35 0.80 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.0155"/>
      <geometry>
        <box size="0.0406 0.1126 0.031"/>
      </geometry>
    </collision>
  </link>
  <joint name="battery_tray_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery_tray_link"/>
    <!-- 背面 x = 0.080 - outer_x/2 + outer_x = 0.0203+0.080; 挂唇底
           z = -0.0017 + 0.027 = 0.0253 (中层甲板顶面)。 -->
    <origin rpy="0 0 0" xyz="0.1003 0 -0.0017"/>
  </joint>
  <link name="battery_2s_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.18"/>
      <inertia ixx="0.000174" ixy="0" ixz="0" iyy="0.0000250" iyz="0" izz="0.000182"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.033 0.105 0.024"/>
      </geometry>
      <material name="lipo_gray">
        <color rgba="0.25 0.26 0.30 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.033 0.105 0.024"/>
      </geometry>
    </collision>
  </link>
  <joint name="battery_2s_joint" type="fixed">
    <parent link="battery_tray_link"/>
    <child link="battery_2s_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.015"/>
  </joint>
