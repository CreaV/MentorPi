    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- STM32 board center ruler-measured 5.4cm behind base center, laterally
         symmetric; z est. Translation is cosmetic: EKF fuses only gyro vyaw
         and Madgwick only the gravity vector, both position-independent. Only
